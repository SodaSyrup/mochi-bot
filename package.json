{
  "name": "mochi-bot",
  "version": "1.0.0",
  "description": "Mochi - An All-Purpose Discord Bot with Invite Tracking & Real-Time Web Dashboard",
  "main": "src/index.js",
  "type": "commonjs",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun --watch src/index.js",
    "deploy-commands": "bun src/bot/deploy.js",
    "rebuild-projections": "bun scripts/rebuild-invite-projections.js",
    "test": "bun test"
  },
  "keywords": [
    "discord-bot",
    "invite-tracker",
    "dashboard",
    "moderation",
    "discordjs",
    "mochi"
  ],
  "author": "Mochi Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "morgan": "^1.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
