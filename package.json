{
  "name": "mochi-bot",
  "version": "1.0.0",
  "description": "Mochi - An All-Purpose Discord Bot with Invite Tracking & Real-Time Web Dashboard",
  "main": "src/index.ts",
  "exports": {
    "./plugin-api": "./src/plugins/sdk.ts"
  },
  "type": "commonjs",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart mochi --update-env",
    "pm2:stop": "pm2 stop mochi",
    "pm2:delete": "pm2 delete mochi",
    "pm2:logs": "pm2 logs mochi",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "deploy-commands": "bun src/bot/deploy.ts",
    "rebuild-projections": "bun scripts/rebuild-invite-projections.ts",
    "test": "bun test",
    "test:worker": "bun test tests/cloudflareGlobalBanWorker.test.js",
    "typecheck": "bun run typecheck:server && bun run typecheck:tests && bun run typecheck:browser && bun run typecheck:worker",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "typecheck:worker": "tsc -p cloudflare/global-bans/tsconfig.json",
    "check": "bun run typecheck && bun test"
  },
  "keywords": [
    "discord-bot",
    "invite-tracker",
    "dashboard",
    "moderation",
    "discordjs",
    "mochi"
  ],
  "author": "Mochi Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "morgan": "^1.11.0",
    "pm2": "^7.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.3.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}
