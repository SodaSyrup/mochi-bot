# Mochi Discord Bot Configuration

# Discord Bot Credentials
# Obtain these from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Bot Owner Discord ID (optional, for owner-only features)
OWNER_ID=

# Dashboard Server Settings
PORT=3000
SESSION_SECRET=mochi_secret_session_key_random_64_characters_long_change_me
DASHBOARD_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/auth/callback

# Bot Configuration
DEFAULT_PREFIX=!
EMBED_COLOR=#7c3aed
DATABASE_PATH=./data/mochi.sqlite

# Mock/Sandbox Mode
# When true or when DISCORD_TOKEN is not configured, runs dashboard & bot simulator for testing
DEMO_MODE=true
