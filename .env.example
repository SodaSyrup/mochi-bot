# Mochi Discord Bot Configuration

# Application mode. One of:
#   development  -> may connect to real Discord if credentials exist
#   production   -> requires full live configuration; fails startup otherwise
APP_MODE=development

# Development authentication bypass. Defaults to false. When true AND
# APP_MODE=development AND the request originates from a loopback address, a
# local development admin session may be created without Discord OAuth.
# NEVER enable this in production — production refuses to start with it set.
DEV_AUTH_BYPASS=false

# Optional authorization snapshot TTL (seconds). Guild-management permissions
# fetched from Discord at login are re-validated after this interval instead of
# being trusted for the entire session lifetime. Default: 600 (10 minutes).
GUILD_PERMISSION_CACHE_TTL_SECONDS=600

# Discord Bot Credentials
# Obtain these from https://discord.com/developers/applications
# Required for APP_MODE=production (and for live Discord in development).
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# Dashboard Server Settings
PORT=3000
# Required for production. Must be a unique random value (never the default).
SESSION_SECRET=
# Session cookie lifetime in seconds. Default: 604800 (7 days).
SESSION_TTL_SECONDS=604800
# Signed cookie name. Keep stable when rotating deployments.
SESSION_COOKIE_NAME=mochi.sid
# Durable server-side session database. Keep this on persistent storage.
SESSION_STORE_PATH=./data/mochi-sessions.sqlite
# Public dashboard URL. Change this to your domain when deploying.
DASHBOARD_URL=http://localhost:3000
# Optional OAuth callback URL. Leave blank to derive it from DASHBOARD_URL.
REDIRECT_URI=

# Bot Configuration
EMBED_COLOR=#7c3aed

# Built-in plugins to disable globally. Leave empty to enable all plugins.
# Valid IDs: utility, invites, invite-logs, safety, honeypot, permission-groups, global-bans
DISABLED_PLUGINS=

# Global protection. The bot talks to a narrow Cloudflare Worker API; it does
# not use a broad Cloudflare account API token. Per-guild mode defaults to
# disabled and must be enabled from the dashboard.
GLOBAL_BANS_API_URL=
GLOBAL_BANS_SYNC_TOKEN=
# Optional owner-only global registry. Configure both values together on the
# Mochi instance that is allowed to manage the central registry. The admin
# token is the same value stored in the Worker as ADMIN_TOKEN.
GLOBAL_BANS_ADMIN_USER_IDS=
GLOBAL_BANS_ADMIN_TOKEN=
GLOBAL_BANS_SYNC_INTERVAL_SECONDS=30
GLOBAL_BANS_REQUEST_TIMEOUT_MS=5000
GLOBAL_BANS_MAX_CACHE_STALENESS_SECONDS=86400
GLOBAL_BANS_GUILD_CONCURRENCY=3
GLOBAL_BANS_JOB_MAX_ATTEMPTS=8
GLOBAL_BANS_ENFORCEMENT_ENABLED=true

# Database paths
# Live/development data.
DATABASE_PATH=./data/mochi.sqlite

# Invite tracking
# Minimum account age (days) before a joined account is considered trusted.
FAKE_ACCOUNT_THRESHOLD_DAYS=7
